{
  "type": "script",
  "params": {
    "type": "double",
    "is_3d": false
  },
  "script": [
    "if(!`venture:continents/continent`:",
      "return(1.0L)",
    ")",
    "",
    "double distance_to_nearest_continent = `venture:continents/continent_lod_0`.soft_distance",
    "return(1.0L + (1.0L - distance_to_nearest_continent) * 100.0L)"
  ]
}
